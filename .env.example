# Copy this file to `.env` and adjust the values for your machine.
# =============================================================================
# Backend (Express server in server/) — NEVER expose these to the frontend.
# =============================================================================

# Local PostgreSQL connection string.
# Default assumes: database name = gritsync, user = postgres, password = postgres
# Adjust user/password/port to match your local PostgreSQL installation.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gritsync

# JWT secret used by server/middleware/auth.ts to sign auth tokens.
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# Stripe secret key (server-side). Use sk_test_... for local development.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional: Stripe webhook secret (only needed if testing webhooks locally via
# `stripe listen --forward-to localhost:3001/api/payments/webhook`)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: Resend email API key for sending emails.
# Leave blank to disable email sending locally.
# RESEND_API_KEY=

# Dev only: skip the "verify your email before logging in" gate so new accounts
# work immediately. Ignored unless NODE_ENV !== 'production'.
SKIP_EMAIL_VERIFICATION=true

# Server-controlled admin allowlist (comma-separated personal emails). A user
# who registers with one of these addresses is created as an admin (and an
# existing matching account is promoted on next login).
ADMIN_EMAILS=

# Server port (must match the vite.config.ts proxy target port)
PORT=3001
NODE_ENV=development

# =============================================================================
# Frontend (Vite) — only public/non-secret values go here.
# =============================================================================

# Stripe publishable key for the frontend Stripe.js integration.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
