# Copy this file to `.env` and adjust the values for your machine.
# =============================================================================
# Backend (Express server in server/) — NEVER expose these to the frontend.
# =============================================================================

# Local PostgreSQL connection string.
# Default assumes: database name = gritsync, user = postgres, password = postgres
# Adjust user/password/port to match your local PostgreSQL installation.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gritsync

# JWT secret used by server/middleware/auth.ts to sign auth tokens.
JWT_SECRET=dev-only-change-me-to-a-long-random-string

# Stripe secret key (server-side). Use sk_test_... for local development.
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional: Stripe webhook secret (only needed if testing webhooks locally via
# `stripe listen --forward-to localhost:3001/api/payments/webhook`)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional: Resend email API key for sending emails.
# Leave blank to disable email sending locally.
# RESEND_API_KEY=

# OpenAI API key — used by server/routes/social-ai.ts for image generation
# (gpt-image-1) and other AI features. Get one at https://platform.openai.com/api-keys.
# Leave blank to disable OpenAI-backed endpoints.
OPENAI_API_KEY=

# Google AI Studio API key — used for Gemini 2.5 Flash Image ("Nano Banana") in
# the Compose post-generator. Get one at https://aistudio.google.com/apikey.
# Leave blank to disable the Nano Banana image provider.
GOOGLE_API_KEY=

# xAI API key — used for Grok image generation (grok-2-image) in the Compose
# post-generator. Get one at https://console.x.ai. Leave blank to disable Grok.
XAI_API_KEY=

# Kling AI (Kuaishou) — image generation via kling-v1-5. Auth is a JWT signed
# with HS256 from { access_key, secret_key } — both required. Get them at
# https://app.klingai.com/global/dev/document-api. Optional KLING_HOST defaults
# to the Singapore endpoint; switch to https://api.klingai.com for CN region.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_HOST=

# Dev only: skip the "verify your email before logging in" gate so new accounts
# work immediately. Ignored unless NODE_ENV !== 'production'.
SKIP_EMAIL_VERIFICATION=true

# Server-controlled admin allowlist (comma-separated personal emails). A user
# who registers with one of these addresses is created as an admin (and an
# existing matching account is promoted on next login).
ADMIN_EMAILS=

# Server port (must match the vite.config.ts proxy target port)
PORT=3001
NODE_ENV=development

# Comma-separated list of origins allowed by CORS (server/index.ts). If unset,
# development allows any origin; production falls back to the gritsync.com domains.
ALLOWED_ORIGINS=http://localhost:5173,https://gritsync.com,https://www.gritsync.com,https://app.gritsync.com,https://review.gritsync.com

# Secret required by the /api/cron/tick endpoint (sent by Vercel Cron as
# `Authorization: Bearer <CRON_SECRET>`). The endpoint returns 401 unless this
# is set AND matches — generate a long random string.
CRON_SECRET=replace-with-a-long-random-string

# =============================================================================
# GS Method automation — Mandatory Courses Agent (nyrequirements.com)
# =============================================================================
# Real credit card used by the agent to purchase the $30 "All Courses" bundle.
# These NEVER leave the backend. Never commit a real card. Format examples below.
NYR_CC_NUMBER=4242424242424242        # 16 digits, no spaces
NYR_CC_EXP_MONTH=12                   # 2-digit month, 01–12
NYR_CC_EXP_YEAR=2030                  # 4-digit year
NYR_CC_CVC=123                        # 3 or 4 digits
NYR_CC_NAME=Jane Doe                  # Cardholder name as it appears on the card
NYR_CC_ZIP=10001                      # Billing ZIP / postal code
# Optional override for the agent's browser viewport / headed mode (default: headless)
NYR_AGENT_HEADLESS=true
# Optional: extra slow-down between steps for debugging (ms)
NYR_AGENT_SLOWMO=0

# =============================================================================
# Frontend (Vite) — only public/non-secret values go here.
# =============================================================================

# Stripe publishable key for the frontend Stripe.js integration.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# --- Backend service keys (were only documented in env.production.example) ---
# Resend transactional email (falls back to the resendApiKey site setting)
RESEND_API_KEY=
# Supabase admin client (server-side only — never expose to the frontend)
SUPABASE_SERVICE_ROLE_KEY=
# Base URL the frontend calls for /api (empty = same origin)
VITE_API_URL=
# Public site origin used in generated links/emails
FRONTEND_URL=https://gritsync.com
# Set to 1 behind a reverse proxy (Vercel/Cantila) so req.ip is the client IP
TRUST_PROXY=1
